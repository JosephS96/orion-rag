# ── LLM Provider Keys ──────────────────────────────────────────────────────
# Add keys for the providers you want to use. The UI will only show providers
# that have a key configured here. You need at least one.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# ── Optional Overrides ─────────────────────────────────────────────────────
# EMBEDDING_MODEL=all-MiniLM-L6-v2    # Default: all-MiniLM-L6-v2 (local)
# CHROMA_PERSIST_DIR=./data/chroma     # Where ChromaDB stores its data
# RETRIEVAL_TOP_K=5                    # Number of chunks to retrieve per query